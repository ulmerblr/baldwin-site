# Copy to .env.local for local development. Never commit real values.
# In production these are set in the Vercel project, not in a file.

# Resend API key. https://resend.com -> API Keys
RESEND_API_KEY=

# Where form notifications are delivered.
NOTIFY_EMAIL=

# Optional. Verified Resend sender. Defaults to Resend's shared onboarding
# sender, which works before your domain is verified.
# NOTIFY_FROM="Baldwin Site <onboarding@resend.dev>"

# Optional, unset today. When the ATS exists, setting the intake URL turns on
# application forwarding in src/lib/notify.ts.
# ATS_INTAKE_URL=
# ATS_SHARED_SECRET=
